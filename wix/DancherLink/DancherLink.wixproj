<Project Sdk="WixToolset.Sdk/6.0.2" ToolsVersion="5.0">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DefineConstants>Debug</DefineConstants>
  </PropertyGroup>
  <PropertyGroup>
    <OutputPath>$(BuildFolder)\</OutputPath>
    <IntermediateOutputPath>$(BuildFolder)\obj\</IntermediateOutputPath>
    <OutputName>DancherLink</OutputName>
  </PropertyGroup>
  <PropertyGroup>
    <SuppressIces>ICE69;ICE61</SuppressIces>
  </PropertyGroup>
  <PropertyGroup Condition="$(SIGN)!=''">
    <SignOutput>true</SignOutput>
  </PropertyGroup>
  <!-- WiX preprocessor variables -->
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);Version=$(Version);DeployDir=$(DeployFolder);BuildDir=$(BuildFolder)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="6.0.2" />
  </ItemGroup>
  <!-- Remove all default .wxs files first -->
  <ItemGroup>
    <WixSource Remove="*.wxs" />
  </ItemGroup>
  <!-- Specify which .wxs file to use based on ProductWxs property -->
  <ItemGroup Condition="$(ProductWxs) != ''">
    <WixSource Include="$(MSBuildThisFileDirectory)\$(ProductWxs)" />
  </ItemGroup>
  <ItemGroup Condition="$(ProductWxs) == ''">
    <WixSource Include="$(MSBuildThisFileDirectory)\Product.wxs" />
  </ItemGroup>
</Project>
